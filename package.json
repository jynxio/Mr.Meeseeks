{
    "name": "buzz",
    "version": "0.1.0",
    "type": "module",
    "scripts": {
        "dev:app": "vp run app#dev",
        "dev:ui": "vp run ui-playground#dev",
        "build:app": "vp run app#build",
        "build:ui": "vp run ui#build",
        "verify": "vp fmt && vp lint && vp run -r test && vp run -r build",
        "verify:code": "vp check --fix",
        "verify:type": "vp exec tsc --noEmit -p tsconfig.json && vp run --filter \"./apps/*\" --filter \"./packages/*\" --filter \"./playgrounds/*\" verify:type",
        "prepare": "vp config"
    },
    "dependencies": {
        "@ai-sdk/google": "catalog:",
        "@ai-sdk/openai-compatible": "catalog:",
        "immer": "catalog:",
        "nanoid": "catalog:",
        "nanostores": "catalog:",
        "remeda": "catalog:",
        "swr": "catalog:",
        "ts-pattern": "catalog:",
        "use-immer": "catalog:"
    },
    "devDependencies": {
        "type-fest": "catalog:",
        "vite-plus": "catalog:"
    },
    "engines": {
        "node": ">=22.12.0"
    },
    "packageManager": "pnpm@10.33.0",
    "pnpm": {
        "onlyBuiltDependencies": [
            "electron",
            "esbuild"
        ]
    }
}
